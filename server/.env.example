# Fabric registry integration is disabled unless explicitly enabled.
AUTHVAULT_BLOCKCHAIN_ENABLED=false
AUTHVAULT_FABRIC_INTEGRATION_TEST_ENABLED=false

# Bounded cross-owner pHash discovery window for Verify Originality.
AUTHVAULT_PHASH_REGISTRY_SCAN_LIMIT=100

AUTHVAULT_FABRIC_MSP_ID=CreatorsOrgMSP
AUTHVAULT_FABRIC_CHANNEL=vaultchain-channel
AUTHVAULT_FABRIC_CHAINCODE=registered-original-registry
AUTHVAULT_FABRIC_PEER_ENDPOINT=localhost:7051
AUTHVAULT_FABRIC_PEER_HOST_OVERRIDE=peer0.creators.vaultchain.local

# These paths are relative to server/ and are created by blockchain/scripts/network-up.sh.
AUTHVAULT_FABRIC_TLS_CERT_PATH=../blockchain/generated/organizations/peerOrganizations/creators.vaultchain.local/peers/peer0.creators.vaultchain.local/tls/ca.crt
AUTHVAULT_FABRIC_CERT_PATH=../blockchain/generated/organizations/peerOrganizations/creators.vaultchain.local/users/Admin@creators.vaultchain.local/msp/signcerts/Admin@creators.vaultchain.local-cert.pem
AUTHVAULT_FABRIC_PRIVATE_KEY_PATH=../blockchain/generated/organizations/peerOrganizations/creators.vaultchain.local/users/Admin@creators.vaultchain.local/msp/keystore/priv_sk
